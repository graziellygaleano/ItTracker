# Copie este arquivo para .env e preencha com os dados do Supabase.
# Encontre os valores em Project Settings > API Keys / Connect.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_PUBLICA

# Nunca coloque SUPABASE_SECRET_KEY ou service_role em variáveis VITE_ ou no navegador.
