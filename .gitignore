# 1. Dependências (nunca devem ir pro repositório)
node_modules/
.pnp
.pnp.js

# 2. Arquivos de ambiente e segredos (essencial por segurança)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# 3. Pastas de Build e Saída (geradas automaticamente)
dist/
build/
out/
.next/
.nuxt/
.cache/

# 4. Logs de erro e debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# 5. Arquivos de Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini

# 6. Configurações de IDE e Editores (opcional, mas recomendado)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# 7. Testes e Cobertura
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/